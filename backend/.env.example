# Copia este archivo como backend/.env y completa los valores.
# backend/.env NUNCA se sube a Git (está en .gitignore).

# --- Base de datos ---------------------------------------------------
# Local con Docker:
DATABASE_URL=postgresql://cartera_admin:desarrollo_local_2026@localhost:5433/cartera
# Supabase (usar el "Session pooler", NO la conexión directa: la directa es
# solo IPv6 y suele fallar desde Windows y desde los hostings):
# DATABASE_URL=postgresql://postgres.<ref-del-proyecto>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- General ---------------------------------------------------------
# development | test | demo | production
ENVIRONMENT=development
# URL donde se abre el frontend (los correos de recuperación apuntan acá)
URL_PUBLICA=http://localhost:5173
# Imprime cada consulta SQL en la consola (solo para depurar)
SQL_ECHO=false

# --- Seguridad (OBLIGATORIO en producción) ---------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Opcional: clave de cifrado de las semillas 2FA (Fernet). Si se omite se
# deriva de SECRET_KEY. Generar con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CLAVE_CIFRADO=
# Dominios aceptados en producción, separados por coma (ej. app.cartera.cl)
HOSTS_PERMITIDOS=

# --- Correo de la plataforma (recuperación de contraseña, invitaciones) -
# Google Workspace: smtp.gmail.com / 587 / la casilla / una "contraseña de
# aplicación" (myaccount.google.com → Seguridad → Contraseñas de aplicaciones)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=
